#include <stdio.h>
#include <ctype.h>
#define size 100
float stack[size];
int top = -1;

void push(float item)
{
    if(top == size - 1)
    {
        printf("\nStack is full!");
        return;
    }
    top++;
    stack[top] = item;
}
float pop()
{
    if(top == -1)
    {
        printf("\nStack is empty!");
        return 0;
    }

    return stack[top--];
}
float evaluate(char postfix[])
{
    int i;
    float op1, op2, result;

    for(i = 0; postfix[i] != '\0'; i++)
    {
        if(postfix[i] == ' ')
            continue;

        if(isdigit(postfix[i]))
        {
            push(postfix[i] - '0');
        }
        else
        {
            if(top < 1)
            {
                printf("\nInvalid postfix expression!");
                return 0;
            }
            op2 = pop();
            op1 = pop();

            switch(postfix[i])
            {
                case '+':
                    result = op1 + op2;
                    break;
                case '-':
                    result = op1 - op2;
                    break;
                case '*':
                    result = op1 * op2;
                    break;
                case '/':
                    if(op2 == 0)
                    {
                        printf("\nDivision by zero is not allowed!");
                        return 0;
                    }
                    result = op1 / op2;
                    break;

                default:
                    printf("\nInvalid operator!");
                    return 0;
            }
            push(result);
        }
    }
    if(top != 0)
    {
        printf("\nInvalid postfix expression!");
        return 0;
    }
    return pop();
}
int main()
{
    char postfix[size];
    float result;

    printf("Enter postfix expression: ");
    scanf("%99s", postfix);

    result = evaluate(postfix);

    printf("\nResult of postfix expression = %.2f", result);

    return 0;
}
